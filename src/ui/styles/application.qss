}

[meetingUiTone="dark"] QSpinBox::up-button:disabled,
[meetingUiTone="dark"] QDoubleSpinBox::up-button:disabled,
[meetingUiTone="dark"] QDateEdit::up-button:disabled,
[meetingUiTone="dark"] QDateTimeEdit::up-button:disabled,
[meetingUiTone="dark"] QTimeEdit::up-button:disabled,
[meetingUiTone="dark"] QSpinBox::down-button:disabled,
[meetingUiTone="dark"] QDoubleSpinBox::down-button:disabled,
[meetingUiTone="dark"] QDateEdit::down-button:disabled,
[meetingUiTone="dark"] QDateTimeEdit::down-button:disabled,
[meetingUiTone="dark"] QTimeEdit::down-button:disabled {
