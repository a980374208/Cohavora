    border-color: @danger@;
}

QProgressDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:hover {
    background: @danger-hover@;
    border-color: @danger-hover@;
}

QProgressDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:pressed {
