}

QInputDialog[meetingUiTone="light"] QComboBox QAbstractItemView {
    background: #ffffff;
    color: #1f2329;
    border: 1px solid #dcdfe6;
    border-radius: 7px;
    padding: 4px;
    outline: none;
    selection-background-color: #eaf3ff;
    selection-color: #1677ff;
}

QInputDialog[meetingUiTone="light"] QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0 9px;
    border-radius: 5px;
}

QInputDialog[meetingUiTone="light"] QPushButton {
    min-width: 76px;
    min-height: 32px;
    padding: 0 14px;
