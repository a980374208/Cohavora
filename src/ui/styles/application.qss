    background: #eaf3ff;
}

QInputDialog[meetingUiTone="light"] QPushButton:disabled {
    color: #a8abb2;
    background: #f5f6f7;
    border-color: #e4e7ed;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="primary"] {
    background: #1677ff;
    color: #ffffff;
    border-color: #1677ff;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:hover {
    background: #4096ff;
