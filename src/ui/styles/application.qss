}

QProgressDialog[meetingUiTone="light"] {
    background: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QProgressDialog[meetingUiTone="light"] QLabel {
