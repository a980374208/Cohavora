QMessageBox[meetingUiTone="light"] {
    background: #ffffff;
    border: 1px solid #dfe3e8;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMessageBox[meetingUiTone="light"] QLabel {
    color: #1f2329;
    font-size: 13px;
}

QMessageBox[meetingUiTone="light"] QLabel[objectName="qt_msgbox_label"] {
    min-width: 340px;
    max-width: 520px;
    padding: 8px 4px 10px 4px;
}

QMessageBox[meetingUiTone="light"] QLabel[objectName="qt_msgbox_informativelabel"] {
    color: #606266;
    padding: 0 4px 8px 4px;
}

QMessageBox[meetingUiTone="light"] QCheckBox {
    color: #606266;
    spacing: 8px;
}

QMessageBox[meetingUiTone="light"] QPushButton {
    min-width: 76px;
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    background: #ffffff;
    color: #303133;
    font-size: 13px;
}

QMessageBox[meetingUiTone="light"] QPushButton:hover {
    color: #1677ff;
    border-color: #8fc2ff;
    background: #f5f9ff;
}

QMessageBox[meetingUiTone="light"] QPushButton:pressed {
    color: #0958d9;
    border-color: #1677ff;
    background: #eaf3ff;
}

QMessageBox[meetingUiTone="light"] QPushButton:disabled {
    color: #a8abb2;
    background: #f5f6f7;
    border-color: #e4e7ed;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"] {
    background: #1677ff;
    color: #ffffff;
    border-color: #1677ff;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:hover {
    background: #4096ff;
    border-color: #4096ff;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:pressed {
    background: #0958d9;
    border-color: #0958d9;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"] {
    background: #d9363e;
    color: #ffffff;
    border-color: #d9363e;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:hover {
    background: #ed5a60;
    border-color: #ed5a60;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:pressed {
    background: #b5222a;
    border-color: #b5222a;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="link"] {
    background: transparent;
    color: #1677ff;
    border-color: transparent;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="link"]:hover {
    color: #4096ff;
    background: #f5f9ff;
}

QInputDialog[meetingUiTone="light"] {
    background: #ffffff;
    border: 1px solid #dcdfe6;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QInputDialog[meetingUiTone="light"] QLabel {
    color: #1f2329;
    font-size: 13px;
}

QInputDialog[meetingUiTone="light"] QLineEdit,
QInputDialog[meetingUiTone="light"] QComboBox,
QInputDialog[meetingUiTone="light"] QSpinBox,
QInputDialog[meetingUiTone="light"] QDoubleSpinBox {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid #dcdfe6;
    border-radius: 6px;
    background: #ffffff;
    color: #1f2329;
    selection-background-color: #1677ff;
    selection-color: #ffffff;
}

QInputDialog[meetingUiTone="light"] QLineEdit:focus,
QInputDialog[meetingUiTone="light"] QComboBox:focus,
QInputDialog[meetingUiTone="light"] QSpinBox:focus,
QInputDialog[meetingUiTone="light"] QDoubleSpinBox:focus {
