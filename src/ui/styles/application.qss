}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"] {
    background: #d9363e;
    color: #ffffff;
    border-color: #d9363e;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:hover {
