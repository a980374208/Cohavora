/* Telemetry uses the shared theme surface, typography and rounded controls. */
QDialog[uiStyle="telemetry-panel"],
[uiStyle="telemetry-panel"] QWidget {
    background: @surface@;
    color: @text@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}
[uiStyle="telemetry-panel"] QPushButton,
[uiStyle="telemetry-panel"] QComboBox {
    background: @surface-alt@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    min-height: 30px;
    padding: 0 12px;
}
[uiStyle="telemetry-panel"] QComboBox { padding-right: 36px; }
[uiStyle="telemetry-panel"] QPushButton:hover,
[uiStyle="telemetry-panel"] QPushButton:checked {
    background: @hover@;
}
[uiStyle="telemetry-panel"] QPushButton:focus,
[uiStyle="telemetry-panel"] QComboBox:focus { border-color: @accent@; }
[uiStyle="telemetry-panel"] QPushButton:pressed { background: @pressed@; }
[uiStyle="telemetry-panel"] QPushButton:disabled,
[uiStyle="telemetry-panel"] QComboBox:disabled {
    background: @surface-alt@;
    color: @text-muted@;
    border-color: @border@;
}
[uiStyle="telemetry-panel"] QTabWidget::pane {
    border: 1px solid @border@;
    border-radius: 6px;
}
[uiStyle="telemetry-panel"] QTabBar::tab {
    background: @surface-alt@;
    color: @text@;
    padding: 8px 18px;
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
}
[uiStyle="telemetry-panel"] QTabBar::tab:selected { background: @hover@; }
[uiStyle="telemetry-panel"] QHeaderView::section {
    background: @surface-alt@;
    color: @text@;
    border: none;
    padding: 6px;
}
[uiStyle="telemetry-panel"] QTableWidget {
    background: @surface@;
    alternate-background-color: @surface-alt@;
    gridline-color: @border@;
    selection-background-color: @hover@;
}

/* Opt-in for ordinary dialogs and Qt's non-native file chooser. Define both
   colors: Windows may otherwise draw a light native surface with dark-theme text.
   Keep these rules after the telemetry ancestor rules for its child chooser. */
QDialog[uiStyle="standard-dialog"] {
    background: @surface@;
    color: @text@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}
[uiStyle="standard-dialog"] QPushButton {
    background: @surface-alt@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    min-height: 30px;
    padding: 0 14px;
}
[uiStyle="standard-dialog"] QPushButton:hover { background: @hover@; }
[uiStyle="standard-dialog"] QPushButton:pressed { background: @pressed@; }
[uiStyle="standard-dialog"] QPushButton:focus,
[uiStyle="standard-dialog"] QPushButton:default { border-color: @accent@; }
[uiStyle="standard-dialog"] QLineEdit,
[uiStyle="standard-dialog"] QComboBox {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 6px;
    min-height: 30px;
    padding: 0 8px;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
}
[uiStyle="standard-dialog"] QComboBox { padding-right: 36px; }
[uiStyle="standard-dialog"] QLineEdit:focus,
[uiStyle="standard-dialog"] QComboBox:focus { border-color: @accent@; }
[uiStyle="standard-dialog"] QPushButton:disabled,
[uiStyle="standard-dialog"] QLineEdit:disabled,
[uiStyle="standard-dialog"] QComboBox:disabled {
    background: @surface-alt@;
    color: @text-muted@;
    border-color: @border@;
}
[uiStyle="standard-dialog"] QHeaderView::section,
[uiStyle="standard-dialog"] QTableCornerButton::section {
    background: @surface-alt@;
    color: @text@;
    border: none;
    padding: 6px;
}
