/* Theme tokens are resolved by AppTheme before installing this sheet. */

QDialog {
    background: @surface@;
    color: @text@;
}

[meetingUiSurfacePalette="true"] {
    background: @surface@;
    color: @text@;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
}

QCheckBox::indicator,
QRadioButton::indicator {
    width: 16px;
    height: 16px;
    background: @surface@;
    border: 1px solid @border@;
}

QCheckBox::indicator {
    border-radius: 4px;
}

QRadioButton::indicator {
    border-radius: 9px;
}

QCheckBox::indicator:hover,
QRadioButton::indicator:hover {
    border-color: @accent@;
    background: @hover@;
}

QCheckBox::indicator:checked,
QRadioButton::indicator:checked {
    border-color: @accent@;
    background: @accent@;
}

QCheckBox::indicator:checked {
    image: url(:/meeting-ui/icons/checkmark-@arrow-tone@.svg);
}

QRadioButton::indicator:checked {
    image: url(:/meeting-ui/icons/radio-dot-@arrow-tone@.svg);
}

QCheckBox::indicator:checked:hover,
QRadioButton::indicator:checked:hover {
    border-color: @accent-hover@;
    background: @accent-hover@;
}

QCheckBox::indicator:pressed,
QRadioButton::indicator:pressed {
    border-color: @accent-pressed@;
}

QCheckBox::indicator:checked:pressed,
QRadioButton::indicator:checked:pressed {
    background: @accent-pressed@;
}

QCheckBox::indicator:disabled,
QRadioButton::indicator:disabled {
    border-color: @border@;
    background: @surface-alt@;
}

QCheckBox::indicator:checked:disabled,
QRadioButton::indicator:checked:disabled {
    border-color: @text-muted@;
    background: @text-muted@;
}

QLineEdit, QTextEdit, QPlainTextEdit, QListView, QTreeView, QTableView {
    color: @text@;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
}

QToolTip {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 5px 8px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}

QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 4px;
    outline: none;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
}

QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0 9px;
    border-radius: 5px;
}

/* Combo popups are reparented into a Qt::Popup window. The direct tone
   selector keeps their colors independent from a dark dialog/meeting host. */
QAbstractItemView[meetingUiTone="light"] {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    outline: none;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
}

QAbstractItemView[meetingUiTone="light"]::item {
    min-height: 30px;
    padding: 0 9px;
    color: @text@;
    background: @surface@;
}

QAbstractItemView[meetingUiTone="light"]::item:hover,
QAbstractItemView[meetingUiTone="light"]::item:selected {
    color: @accent@;
    background: @accent-soft@;
}

QAbstractItemView[meetingUiTone="dark"] {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    outline: none;
    selection-background-color: @hover@;
    selection-color: @text@;
}

QAbstractItemView[meetingUiTone="dark"]::item {
    min-height: 30px;
    padding: 0 9px;
    color: @text@;
    background: @surface@;
}

QAbstractItemView[meetingUiTone="dark"]::item:hover,
QAbstractItemView[meetingUiTone="dark"]::item:selected {
    color: @text@;
    background: @hover@;
}

QCalendarWidget {
    background: @surface@;
    color: @text@;
}

QCalendarWidget QWidget[objectName="qt_calendar_navigationbar"] {
    background: @window@;
    border-bottom: 1px solid @border@;
}

QCalendarWidget QToolButton {
    min-height: 30px;
    color: @text@;
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 0 8px;
}

QCalendarWidget QToolButton:hover {
    color: @accent@;
    background: @accent-soft@;
}

QCalendarWidget QSpinBox {
    min-height: 28px;
    color: @text@;
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 0 6px;
}

QCalendarWidget QAbstractItemView {
    background: @surface@;
    color: @text@;
    outline: none;
    selection-background-color: @accent@;
    selection-color: @on-accent@;
}

QComboBox,
QSpinBox,
QDoubleSpinBox,
QDateEdit,
QDateTimeEdit,
QTimeEdit {
    padding-right: 36px;
}

QComboBox::drop-down,
QDateEdit::drop-down,
QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background: transparent;
}

QComboBox::drop-down:hover,
QDateEdit::drop-down:hover,
QDateTimeEdit::drop-down:hover {
    background: @accent-soft@;
}

QComboBox::drop-down:pressed,
QComboBox::drop-down:on,
QDateEdit::drop-down:pressed,
QDateEdit::drop-down:on,
QDateTimeEdit::drop-down:pressed,
QDateTimeEdit::drop-down:on {
    background: @accent-soft@;
}

QComboBox::drop-down:disabled,
QDateEdit::drop-down:disabled,
QDateTimeEdit::drop-down:disabled {
    background: transparent;
}

QComboBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow {
    image: url(:/meeting-ui/icons/chevron-down-@arrow-tone@.svg);
    width: 12px;
    height: 12px;
}

QComboBox::down-arrow:on,
QDateEdit::down-arrow:on,
QDateTimeEdit::down-arrow:on {
    image: url(:/meeting-ui/icons/chevron-up-@arrow-tone@.svg);
}

QComboBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled,
QDateTimeEdit::down-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-down-disabled.svg);
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button,
QDateTimeEdit::up-button,
QTimeEdit::up-button,
QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button,
QDateTimeEdit::down-button,
QTimeEdit::down-button {
    subcontrol-origin: padding;
    width: 32px;
    border: none;
    background: transparent;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button,
QDateEdit::up-button,
QDateTimeEdit::up-button,
QTimeEdit::up-button {
    border-top-right-radius: 6px;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button,
QDateEdit::down-button,
QDateTimeEdit::down-button,
QTimeEdit::down-button {
    border-bottom-right-radius: 6px;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QDateEdit::up-button:hover,
QDateTimeEdit::up-button:hover,
QTimeEdit::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover,
QDateEdit::down-button:hover,
QDateTimeEdit::down-button:hover,
QTimeEdit::down-button:hover {
    background: @accent-soft@;
}

QSpinBox::up-button:pressed,
QDoubleSpinBox::up-button:pressed,
QDateEdit::up-button:pressed,
QDateTimeEdit::up-button:pressed,
QTimeEdit::up-button:pressed,
QSpinBox::down-button:pressed,
QDoubleSpinBox::down-button:pressed,
QDateEdit::down-button:pressed,
QDateTimeEdit::down-button:pressed,
QTimeEdit::down-button:pressed {
    background: @accent-soft@;
}

QSpinBox::up-button:disabled,
QDoubleSpinBox::up-button:disabled,
QDateEdit::up-button:disabled,
QDateTimeEdit::up-button:disabled,
QTimeEdit::up-button:disabled,
QSpinBox::down-button:disabled,
QDoubleSpinBox::down-button:disabled,
QDateEdit::down-button:disabled,
QDateTimeEdit::down-button:disabled,
QTimeEdit::down-button:disabled {
    background: transparent;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow,
QDateEdit::up-arrow,
QDateTimeEdit::up-arrow,
QTimeEdit::up-arrow {
    image: url(:/meeting-ui/icons/chevron-up-@arrow-tone@.svg);
    width: 11px;
    height: 11px;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow,
QDateEdit::down-arrow,
QDateTimeEdit::down-arrow,
QTimeEdit::down-arrow {
    image: url(:/meeting-ui/icons/chevron-down-@arrow-tone@.svg);
    width: 11px;
    height: 11px;
}

QSpinBox::up-arrow:disabled,
QDoubleSpinBox::up-arrow:disabled,
QDateEdit::up-arrow:disabled,
QDateTimeEdit::up-arrow:disabled,
QTimeEdit::up-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-up-disabled.svg);
}

QSpinBox::down-arrow:disabled,
QDoubleSpinBox::down-arrow:disabled,
QDateEdit::down-arrow:disabled,
QDateTimeEdit::down-arrow:disabled,
QTimeEdit::down-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-down-disabled.svg);
}

[meetingUiTone="dark"] QComboBox,
[meetingUiTone="dark"] QSpinBox,
[meetingUiTone="dark"] QDoubleSpinBox,
[meetingUiTone="dark"] QDateEdit,
[meetingUiTone="dark"] QDateTimeEdit,
[meetingUiTone="dark"] QTimeEdit {
    padding-right: 36px;
}

[meetingUiTone="dark"] QComboBox::drop-down,
[meetingUiTone="dark"] QDateEdit::drop-down,
[meetingUiTone="dark"] QDateTimeEdit::drop-down {
    subcontrol-origin: padding;
    subcontrol-position: top right;
    width: 32px;
    border: none;
    border-top-right-radius: 6px;
    border-bottom-right-radius: 6px;
    background: transparent;
}

[meetingUiTone="dark"] QComboBox::drop-down:hover,
[meetingUiTone="dark"] QDateEdit::drop-down:hover,
[meetingUiTone="dark"] QDateTimeEdit::drop-down:hover {
    background: @surface-alt@;
}

[meetingUiTone="dark"] QComboBox::drop-down:pressed,
[meetingUiTone="dark"] QComboBox::drop-down:on,
[meetingUiTone="dark"] QDateEdit::drop-down:pressed,
[meetingUiTone="dark"] QDateEdit::drop-down:on,
[meetingUiTone="dark"] QDateTimeEdit::drop-down:pressed,
[meetingUiTone="dark"] QDateTimeEdit::drop-down:on {
    background: @hover@;
}

[meetingUiTone="dark"] QComboBox::drop-down:disabled,
[meetingUiTone="dark"] QDateEdit::drop-down:disabled,
[meetingUiTone="dark"] QDateTimeEdit::drop-down:disabled {
    background: transparent;
}

[meetingUiTone="dark"] QComboBox::down-arrow,
[meetingUiTone="dark"] QDateEdit::down-arrow,
[meetingUiTone="dark"] QDateTimeEdit::down-arrow {
    image: url(:/meeting-ui/icons/chevron-down-@arrow-tone@.svg);
    width: 12px;
    height: 12px;
}

[meetingUiTone="dark"] QComboBox::down-arrow:on,
[meetingUiTone="dark"] QDateEdit::down-arrow:on,
[meetingUiTone="dark"] QDateTimeEdit::down-arrow:on {
    image: url(:/meeting-ui/icons/chevron-up-@arrow-tone@.svg);
}

[meetingUiTone="dark"] QComboBox::down-arrow:disabled,
[meetingUiTone="dark"] QDateEdit::down-arrow:disabled,
[meetingUiTone="dark"] QDateTimeEdit::down-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-down-disabled.svg);
}

[meetingUiTone="dark"] QSpinBox::up-button,
[meetingUiTone="dark"] QDoubleSpinBox::up-button,
[meetingUiTone="dark"] QDateEdit::up-button,
[meetingUiTone="dark"] QDateTimeEdit::up-button,
[meetingUiTone="dark"] QTimeEdit::up-button,
[meetingUiTone="dark"] QSpinBox::down-button,
[meetingUiTone="dark"] QDoubleSpinBox::down-button,
[meetingUiTone="dark"] QDateEdit::down-button,
[meetingUiTone="dark"] QDateTimeEdit::down-button,
[meetingUiTone="dark"] QTimeEdit::down-button {
    subcontrol-origin: padding;
    width: 32px;
    border: none;
    background: transparent;
}

[meetingUiTone="dark"] QSpinBox::up-button,
[meetingUiTone="dark"] QDoubleSpinBox::up-button,
[meetingUiTone="dark"] QDateEdit::up-button,
[meetingUiTone="dark"] QDateTimeEdit::up-button,
[meetingUiTone="dark"] QTimeEdit::up-button {
    border-top-right-radius: 6px;
}

[meetingUiTone="dark"] QSpinBox::down-button,
[meetingUiTone="dark"] QDoubleSpinBox::down-button,
[meetingUiTone="dark"] QDateEdit::down-button,
[meetingUiTone="dark"] QDateTimeEdit::down-button,
[meetingUiTone="dark"] QTimeEdit::down-button {
    border-bottom-right-radius: 6px;
}

[meetingUiTone="dark"] QSpinBox::up-button:hover,
[meetingUiTone="dark"] QDoubleSpinBox::up-button:hover,
[meetingUiTone="dark"] QDateEdit::up-button:hover,
[meetingUiTone="dark"] QDateTimeEdit::up-button:hover,
[meetingUiTone="dark"] QTimeEdit::up-button:hover,
[meetingUiTone="dark"] QSpinBox::down-button:hover,
[meetingUiTone="dark"] QDoubleSpinBox::down-button:hover,
[meetingUiTone="dark"] QDateEdit::down-button:hover,
[meetingUiTone="dark"] QDateTimeEdit::down-button:hover,
[meetingUiTone="dark"] QTimeEdit::down-button:hover {
    background: @surface-alt@;
}

[meetingUiTone="dark"] QSpinBox::up-button:pressed,
[meetingUiTone="dark"] QDoubleSpinBox::up-button:pressed,
[meetingUiTone="dark"] QDateEdit::up-button:pressed,
[meetingUiTone="dark"] QDateTimeEdit::up-button:pressed,
[meetingUiTone="dark"] QTimeEdit::up-button:pressed,
[meetingUiTone="dark"] QSpinBox::down-button:pressed,
[meetingUiTone="dark"] QDoubleSpinBox::down-button:pressed,
[meetingUiTone="dark"] QDateEdit::down-button:pressed,
