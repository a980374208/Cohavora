}

[meetingUiTone="dark"] QSpinBox::up-arrow,
[meetingUiTone="dark"] QDoubleSpinBox::up-arrow,
[meetingUiTone="dark"] QDateEdit::up-arrow,
[meetingUiTone="dark"] QDateTimeEdit::up-arrow,
[meetingUiTone="dark"] QTimeEdit::up-arrow {
    image: url(:/meeting-ui/icons/chevron-up-@arrow-tone@.svg);
    width: 11px;
    height: 11px;
}

[meetingUiTone="dark"] QSpinBox::down-arrow,
[meetingUiTone="dark"] QDoubleSpinBox::down-arrow,
[meetingUiTone="dark"] QDateEdit::down-arrow,
[meetingUiTone="dark"] QDateTimeEdit::down-arrow,
[meetingUiTone="dark"] QTimeEdit::down-arrow {
    image: url(:/meeting-ui/icons/chevron-down-@arrow-tone@.svg);
    width: 11px;
    height: 11px;
}

[meetingUiTone="dark"] QSpinBox::up-arrow:disabled,
[meetingUiTone="dark"] QDoubleSpinBox::up-arrow:disabled,
[meetingUiTone="dark"] QDateEdit::up-arrow:disabled,
[meetingUiTone="dark"] QDateTimeEdit::up-arrow:disabled,
[meetingUiTone="dark"] QTimeEdit::up-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-up-disabled.svg);
}

[meetingUiTone="dark"] QSpinBox::down-arrow:disabled,
[meetingUiTone="dark"] QDoubleSpinBox::down-arrow:disabled,
[meetingUiTone="dark"] QDateEdit::down-arrow:disabled,
[meetingUiTone="dark"] QDateTimeEdit::down-arrow:disabled,
[meetingUiTone="dark"] QTimeEdit::down-arrow:disabled {
    image: url(:/meeting-ui/icons/chevron-down-disabled.svg);
}

QMessageBox[meetingUiTone="light"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QMessageBox[meetingUiTone="light"] QLabel {
    color: @text@;
    font-size: 13px;
}

QMessageBox[meetingUiTone="light"] QLabel[objectName="qt_msgbox_label"] {
    min-width: 340px;
    max-width: 520px;
    padding: 8px 4px 10px 4px;
}

QMessageBox[meetingUiTone="light"] QLabel[objectName="qt_msgbox_informativelabel"] {
    color: @text-secondary@;
    padding: 0 4px 8px 4px;
}

QMessageBox[meetingUiTone="light"] QCheckBox {
    color: @text-secondary@;
    spacing: 8px;
}

QMessageBox[meetingUiTone="light"] QPushButton {
    min-width: 76px;
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
    color: @text@;
    font-size: 13px;
}

QMessageBox[meetingUiTone="light"] QPushButton:hover {
    color: @accent@;
    border-color: @accent@;
    background: @accent-soft@;
}

QMessageBox[meetingUiTone="light"] QPushButton:pressed {
    color: @accent-pressed@;
    border-color: @accent@;
    background: @accent-soft@;
}

QMessageBox[meetingUiTone="light"] QPushButton:disabled {
    color: @text-muted@;
    background: @surface-alt@;
    border-color: @border@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"] {
    background: @accent@;
    color: @on-accent@;
    border-color: @accent@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:hover {
    background: @accent-hover@;
    border-color: @accent-hover@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:pressed {
    background: @accent-pressed@;
    border-color: @accent-pressed@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"] {
    background: @danger@;
    color: @on-accent@;
    border-color: @danger@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:hover {
    background: @danger-hover@;
    border-color: @danger-hover@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:pressed {
    background: @danger-pressed@;
    border-color: @danger-pressed@;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="link"] {
    background: transparent;
    color: @accent@;
    border-color: transparent;
}

QMessageBox[meetingUiTone="light"] QPushButton[meetingUiRole="link"]:hover {
    color: @accent-hover@;
    background: @accent-soft@;
}

QInputDialog[meetingUiTone="light"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QInputDialog[meetingUiTone="light"] QLabel {
    color: @text@;
    font-size: 13px;
}

QInputDialog[meetingUiTone="light"] QLineEdit,
QInputDialog[meetingUiTone="light"] QComboBox,
QInputDialog[meetingUiTone="light"] QSpinBox,
QInputDialog[meetingUiTone="light"] QDoubleSpinBox {
    min-height: 34px;
    padding: 0 10px;
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
    color: @text@;
    selection-background-color: @accent@;
    selection-color: @on-accent@;
}

QInputDialog[meetingUiTone="light"] QLineEdit:focus,
QInputDialog[meetingUiTone="light"] QComboBox:focus,
QInputDialog[meetingUiTone="light"] QSpinBox:focus,
QInputDialog[meetingUiTone="light"] QDoubleSpinBox:focus {
    border-color: @accent@;
}

QInputDialog[meetingUiTone="light"] QComboBox QAbstractItemView {
    background: @surface@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 4px;
    outline: none;
    selection-background-color: @accent-soft@;
    selection-color: @accent@;
}

QInputDialog[meetingUiTone="light"] QComboBox QAbstractItemView::item {
    min-height: 30px;
    padding: 0 9px;
    border-radius: 5px;
}

QInputDialog[meetingUiTone="light"] QPushButton {
    min-width: 76px;
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
    color: @text@;
    font-size: 13px;
}

QInputDialog[meetingUiTone="light"] QPushButton:hover {
    color: @accent@;
    border-color: @accent@;
    background: @accent-soft@;
}

QInputDialog[meetingUiTone="light"] QPushButton:pressed {
    color: @accent-pressed@;
    border-color: @accent@;
    background: @accent-soft@;
}

QInputDialog[meetingUiTone="light"] QPushButton:disabled {
    color: @text-muted@;
    background: @surface-alt@;
    border-color: @border@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="primary"] {
    background: @accent@;
    color: @on-accent@;
    border-color: @accent@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:hover {
    background: @accent-hover@;
    border-color: @accent-hover@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="primary"]:pressed {
    background: @accent-pressed@;
    border-color: @accent-pressed@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"] {
    background: @danger@;
    color: @on-accent@;
    border-color: @danger@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:hover {
    background: @danger-hover@;
    border-color: @danger-hover@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="danger"]:pressed {
    background: @danger-pressed@;
    border-color: @danger-pressed@;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="link"] {
    background: transparent;
    color: @accent@;
    border-color: transparent;
}

QInputDialog[meetingUiTone="light"] QPushButton[meetingUiRole="link"]:hover {
    color: @accent-hover@;
    background: @accent-soft@;
}

QProgressDialog[meetingUiTone="light"] {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QProgressDialog[meetingUiTone="light"] QLabel {
    color: @text@;
    font-size: 13px;
    padding: 4px 0;
}

QProgressDialog[meetingUiTone="light"] QProgressBar {
    min-height: 8px;
    max-height: 8px;
    border: none;
    border-radius: 4px;
    background: @surface-alt@;
}

QProgressDialog[meetingUiTone="light"] QProgressBar::chunk {
    border-radius: 4px;
    background: @accent@;
}

QProgressDialog[meetingUiTone="light"] QPushButton {
    min-width: 76px;
    min-height: 32px;
    padding: 0 14px;
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
