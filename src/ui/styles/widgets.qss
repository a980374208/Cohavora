/* Application widget variants. Selected with AppTheme::setStyleVariant. */

/* Meeting layout and page popups are separate native windows above the video
   canvas; all colors follow the same live theme tokens as the main window. */
QToolButton[uiStyle="meeting-layout-trigger"] {
    background: @accent-soft@;
    color: @accent@;
    border: 1px solid transparent;
    border-radius: 6px;
    padding: 5px 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 500;
}
QToolButton[uiStyle="meeting-layout-trigger"]:hover,
QToolButton[uiStyle="meeting-layout-trigger"]:focus {
    border-color: @accent@;
}
QToolButton[uiStyle="meeting-layout-trigger"]:pressed {
    background: @pressed@;
    border-color: @accent@;
}
QToolButton[uiStyle="meeting-layout-trigger"]:disabled {
    background: @surface-alt@;
    color: @text-muted@;
}

[uiStyle="meeting-layout-popup"] QLabel,
[uiStyle="meeting-layout-popup"] QCheckBox {
    color: @text@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="meeting-layout-popup"] QScrollArea,
[uiStyle="meeting-layout-popup"] QScrollArea > QWidget,
[uiStyle="meeting-layout-popup"] QScrollArea > QWidget > QWidget {
    background: transparent;
    border: none;
}
[uiStyle="meeting-layout-popup"] QToolButton,
[uiStyle="meeting-video-pager"] QToolButton {
    color: @text@;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 5px;
    padding: 3px 6px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="meeting-layout-popup"] QToolButton:hover,
[uiStyle="meeting-layout-popup"] QToolButton:checked,
[uiStyle="meeting-video-pager"] QToolButton:hover {
    color: @accent@;
    background: @accent-soft@;
}
[uiStyle="meeting-layout-popup"] QToolButton:focus,
[uiStyle="meeting-video-pager"] QToolButton:focus {
    border-color: @accent@;
}
[uiStyle="meeting-layout-popup"] QToolButton:pressed,
[uiStyle="meeting-video-pager"] QToolButton:pressed {
    background: @pressed@;
}
[uiStyle="meeting-layout-popup"] QToolButton:disabled,
[uiStyle="meeting-video-pager"] QToolButton:disabled {
    color: @text-muted@;
}
[uiStyle="meeting-layout-popup"] QLineEdit {
    color: @text@;
    background: @surface-alt@;
    border: 1px solid @border@;
    border-radius: 5px;
    padding: 5px 7px;
    font-size: 13px;
}
[uiStyle="meeting-layout-popup"] QLineEdit:focus {
    border-color: @accent@;
}
[uiStyle="meeting-layout-popup"] QLabel#videoPageJumpError {
    color: @danger@;
}
[uiStyle="meeting-video-pager"] QToolButton#previousVideoPage,
[uiStyle="meeting-video-pager"] QToolButton#nextVideoPage {
    font-size: 22px;
    padding: 0;
}

QWidget[uiStyle="whiteboard-panel"],
[uiStyle="whiteboard-panel"] QScrollArea,
[uiStyle="whiteboard-panel"] QScrollArea > QWidget > QWidget,
[uiStyle="whiteboard-panel"] QWidget#whiteboardTextBox {
    background: @window@;
    color: @text@;
    border: none;
}
[uiStyle="whiteboard-panel"] QLabel {
    color: @text-secondary@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QLabel#whiteboardTitle {
    color: @text@;
    font-size: 16px;
    font-weight: bold;
}
[uiStyle="whiteboard-panel"] QLabel#whiteboardLocalNotice {
    color: @accent@;
    background: @accent-soft@;
    border-radius: 6px;
    padding: 4px 8px;
}
[uiStyle="whiteboard-panel"] QPushButton {
    color: @text@;
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 20px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QPushButton:hover {
    color: @accent@;
    border-color: @accent-soft@;
    background: @accent-soft@;
}
[uiStyle="whiteboard-panel"] QPushButton:checked,
[uiStyle="whiteboard-panel"] QPushButton:pressed {
    color: @accent@;
    border-color: @accent@;
    background: @accent-soft@;
}
[uiStyle="whiteboard-panel"] QPushButton:disabled {
    color: @text-muted@;
    background: @surface-alt@;
    border-color: @border@;
}
[uiStyle="whiteboard-panel"] QComboBox,
[uiStyle="whiteboard-panel"] QSpinBox,
[uiStyle="whiteboard-panel"] QPlainTextEdit {
    color: @text@;
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 6px 36px 6px 8px;
    min-height: 20px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QPlainTextEdit { padding: 6px; }

QDialog[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QDialog {
    background: transparent;
}

[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="loginCard"],
[uiStyle="login-dialog-this"] [objectName="loginCard"] {
    background-color: @surface@;
    border-radius: 16px;
    border: 1px solid @border@;
}

[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="loginCard"][linuxWindowFrameSurface="true"],
[uiStyle="login-dialog-this"] [objectName="loginCard"][linuxWindowFrameSurface="true"] {
    border: none;
    border-radius: 0;
}

QLabel[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QLabel {
    color: @text@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QLineEdit[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QLineEdit {
    border: 1px solid @border@;
    border-radius: 10px;
    padding: 9px 14px;
    font-size: 14px;
    color: @text@;
    background: @window@;
}

QLineEdit[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]:focus,
[uiStyle="login-dialog-this"] QLineEdit:focus {
    border: 1px solid @accent@;
    background: @surface@;
}

[uiStyle="login-dialog-this"] QFrame#loginInputBox {
    background: @window@;
    border: 1px solid @border@;
    border-radius: 10px;
}

[uiStyle="login-dialog-this"] QFrame#loginInputBox[focused="true"] {
    background: @surface@;
    border: 1px solid @accent@;
}

[uiStyle="login-dialog-this"] QFrame#loginInputBox QLineEdit,
[uiStyle="login-dialog-this"] QFrame#loginInputBox QLineEdit:focus {
    border: none;
    border-radius: 0;
    background: transparent;
    padding: 0 4px 0 14px;
}

[uiStyle="login-dialog-this"] QLabel#loginFieldLabel {
    color: @text-secondary@;
    font-size: 12px;
    font-weight: 500;
}

[uiStyle="login-dialog-this"] QPushButton#loginEyeBtn {
    background: transparent;
    border: none;
    border-radius: 7px;
    padding: 0;
}

[uiStyle="login-dialog-this"] QPushButton#loginEyeBtn:hover {
    background: @hover@;
}

[uiStyle="login-dialog-this"] QFrame#loginSegmentBar {
    background: @window@;
    border: 1px solid @border@;
    border-radius: 10px;
}

[uiStyle="login-dialog-this"] QPushButton#loginSegmentBtn {
    background: transparent;
    color: @text-secondary@;
    border: 1px solid transparent;
    border-radius: 7px;
    font-size: 13px;
    font-weight: 500;
    padding: 0 8px;
}

[uiStyle="login-dialog-this"] QPushButton#loginSegmentBtn:hover:!checked {
    background: @hover@;
    color: @text@;
}

[uiStyle="login-dialog-this"] QPushButton#loginSegmentBtn:checked {
    background: @surface@;
    color: @accent@;
    border: 1px solid @border@;
    font-weight: 600;
}

[uiStyle="login-dialog-this"] QFrame#loginSavedSessionCard {
    background: @accent-soft@;
    border: 1px solid @accent@;
    border-radius: 12px;
}

[uiStyle="login-dialog-this"] QLabel#loginSavedAvatar {
    background: @accent@;
    color: @on-accent@;
    border-radius: 18px;
    font-size: 13px;
    font-weight: 600;
}

[uiStyle="login-dialog-this"] QLabel#loginSavedAccount {
    color: @text@;
    font-size: 12px;
    font-weight: 600;
}

[uiStyle="login-dialog-this"] QLabel#loginSavedHint {
    color: @text-secondary@;
    font-size: 11px;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"],
QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"] {
    background-color: @accent@;
    color: @on-accent@;
    border-radius: 10px;
    padding: 10px 24px;
    font-size: 15px;
    font-weight: 600;
    border: none;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:hover,
QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"]:hover {
    background-color: @accent-hover@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:pressed,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:pressed,
QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"]:pressed,
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"]:pressed {
    background-color: @accent-pressed@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:disabled,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:disabled,
QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"]:disabled,
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"]:disabled {
    background-color: @accent-soft@;
    color: @text-muted@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"] {
    background-color: @accent@;
    color: @on-accent@;
    border-radius: 8px;
    padding: 5px 14px;
    font-size: 12px;
    font-weight: 600;
    border: none;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:hover {
    background-color: @accent-hover@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:focus {
    border: 1px solid @on-accent@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:pressed {
    background-color: @accent-pressed@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:disabled {
    background-color: @surface-alt@;
    color: @text-muted@;
    border: 1px solid @border@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="closeBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="closeBtn"] {
    background: transparent;
    border: none;
    color: @text-muted@;
    border-radius: 8px;
    padding: 0;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="closeBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="closeBtn"]:hover {
    background: @danger-soft@;
    color: @danger@;
}

QCheckBox[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QCheckBox {
    font-size: 12px;
    color: @text-secondary@;
}

QTabWidget[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]::pane,
[uiStyle="login-dialog-this"] QTabWidget::pane {
    border: none;
    background: transparent;
}

[uiStyle="login-dialog-subtitle"][uiStyle="login-dialog-subtitle"][uiStyle="login-dialog-subtitle"],
[uiStyle="login-dialog-subtitle"] * {
    color: @text-muted@;
    font-size: 13px;
}

[uiStyle="login-dialog-guestdesc"][uiStyle="login-dialog-guestdesc"][uiStyle="login-dialog-guestdesc"],
[uiStyle="login-dialog-guestdesc"] * {
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-this"] QLabel#loginGuestNotice {
    background: @window@;
    border: 1px solid @border@;
    border-radius: 10px;
    padding: 12px 14px;
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-this"] QFrame#loginFooterBar {
    background: @surface-alt@;
    border-top: 1px solid @border@;
    border-left: none;
    border-right: none;
    border-bottom: none;
    border-bottom-left-radius: 15px;
    border-bottom-right-radius: 15px;
}

[uiStyle="login-dialog-this"] [objectName="loginCard"][linuxWindowFrameSurface="true"] QFrame#loginFooterBar {
    border-bottom-left-radius: 0;
    border-bottom-right-radius: 0;
}

[uiStyle="login-dialog-this"] QFrame#loginTransportBadge {
    background: transparent;
    border: none;
    border-radius: 11px;
}

[uiStyle="login-dialog-this"] QFrame#loginTransportBadge[mode="warning"] {
    background: @warning-soft@;
}

[uiStyle="login-dialog-this"] QLabel#loginTransportBadgeLabel {
    background: transparent;
    color: @text-muted@;
    font-size: 11px;
    font-weight: 500;
}

[uiStyle="login-dialog-this"] QFrame#loginTransportBadge[mode="warning"] QLabel#loginTransportBadgeLabel {
    color: @warning@;
    font-weight: 600;
}

[uiStyle="login-dialog-advancedtogglebtn"][uiStyle="login-dialog-advancedtogglebtn"][uiStyle="login-dialog-advancedtogglebtn"],
[uiStyle="login-dialog-advancedtogglebtn"] * {
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-this"] QPushButton#serverSettingsToggle {
    background: transparent;
    border: 1px solid transparent;
    border-radius: 8px;
    padding: 5px 10px;
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-this"] QPushButton#serverSettingsToggle:hover {
    background: @hover@;
    color: @text@;
}

[uiStyle="login-dialog-this"] QPushButton#serverSettingsToggle[expanded="true"] {
    background: @accent-soft@;
    color: @accent@;
}

[uiStyle="login-dialog-this"] QFrame#loginAdvancedCard {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 11px;
}

[uiStyle="login-dialog-this"] QFrame#loginAdvancedCard QLineEdit {
    background: @window@;
    border-radius: 7px;
    padding: 6px 10px;
    font-size: 12px;
}

[uiStyle="login-dialog-this"] QFrame#loginAdvancedCard QLineEdit:focus {
    background: @surface@;
    border: 1px solid @accent@;
}

[uiStyle="login-dialog-advlabel"][uiStyle="login-dialog-advlabel"][uiStyle="login-dialog-advlabel"],
[uiStyle="login-dialog-advlabel"] * {
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-errorlabel"][uiStyle="login-dialog-errorlabel"][uiStyle="login-dialog-errorlabel"],
[uiStyle="login-dialog-errorlabel"] * {
    color: @danger@;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 8px;
}

[uiStyle="login-dialog-errorlabel-2"][uiStyle="login-dialog-errorlabel-2"][uiStyle="login-dialog-errorlabel-2"],
[uiStyle="login-dialog-errorlabel-2"] * {
    color: @danger@;
    background: @danger-soft@;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 8px;
}

[uiStyle="login-dialog-errorlabel-3"][uiStyle="login-dialog-errorlabel-3"][uiStyle="login-dialog-errorlabel-3"],
[uiStyle="login-dialog-errorlabel-3"] * {
    color: @success@;
    background: @success-soft@;
    font-size: 12px;
    padding: 6px 10px;
    border-radius: 8px;
    font-weight: bold;
}

QDialog[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QDialog {
    background: @surface@;
}

QLabel[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QLabel {
    color: @text@;
    font-size: 13px;
}

QLineEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QLineEdit,
QDateEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QDateEdit,
QDateTimeEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QDateTimeEdit,
QSpinBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QSpinBox,
QComboBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QComboBox {
    min-height: 34px;
    border: 1px solid @border@;
    border-radius: 6px;
    background: @surface@;
}

QLineEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QLineEdit {
    padding: 0 9px;
}

QDateEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QDateEdit,
QDateTimeEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QDateTimeEdit,
QSpinBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QSpinBox,
QComboBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QComboBox {
    padding: 0 36px 0 9px;
}

QLineEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"]:focus,
[uiStyle="meeting-booking-dialog-this"] QLineEdit:focus,
QDateEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"]:focus,
[uiStyle="meeting-booking-dialog-this"] QDateEdit:focus,
QDateTimeEdit[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"]:focus,
[uiStyle="meeting-booking-dialog-this"] QDateTimeEdit:focus,
QSpinBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"]:focus,
[uiStyle="meeting-booking-dialog-this"] QSpinBox:focus,
QComboBox[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"]:focus,
[uiStyle="meeting-booking-dialog-this"] QComboBox:focus {
    border-color: @accent@;
}

QPushButton[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"],
[uiStyle="meeting-booking-dialog-this"] QPushButton {
    min-height: 34px;
    padding: 0 18px;
    border-radius: 6px;
}

QPushButton[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][objectName="primary"],
[uiStyle="meeting-booking-dialog-this"] QPushButton[objectName="primary"] {
    background: @accent@;
    color: @on-accent@;
    border: none;
}

QPushButton[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][objectName="primary"]:hover,
[uiStyle="meeting-booking-dialog-this"] QPushButton[objectName="primary"]:hover {
