/* Main window unified header, centered workspace, and bottom join-preset bar */
QWidget#mainHeaderBar[uiStyle="main-home-window"],
QWidget#mainCenterColumn[uiStyle="main-home-window"] {
    background: transparent;
}
[uiStyle="main-home-window"] QLabel#mainBrandTitle {
    color: @text@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 14px;
    font-weight: 700;
}
[uiStyle="main-home-window"] QLabel#mainDateBadge {
    color: @text-muted@;
    background: transparent;
    border: none;
    padding: 0 2px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 400;
