}

[uiStyle="login-dialog-advlabel"][uiStyle="login-dialog-advlabel"][uiStyle="login-dialog-advlabel"],
[uiStyle="login-dialog-advlabel"] * {
    color: @text-secondary@;
    font-size: 12px;
}

[uiStyle="login-dialog-errorlabel"][uiStyle="login-dialog-errorlabel"][uiStyle="login-dialog-errorlabel"],
[uiStyle="login-dialog-errorlabel"] * {
    color: @danger@;
    font-size: 12px;
    padding: 2px 4px;
}

[uiStyle="login-dialog-errorlabel-2"][uiStyle="login-dialog-errorlabel-2"][uiStyle="login-dialog-errorlabel-2"],
[uiStyle="login-dialog-errorlabel-2"] * {
    color: @danger@;
    font-size: 12px;
    padding: 2px 0;
}

[uiStyle="login-dialog-errorlabel-3"][uiStyle="login-dialog-errorlabel-3"][uiStyle="login-dialog-errorlabel-3"],
[uiStyle="login-dialog-errorlabel-3"] * {
