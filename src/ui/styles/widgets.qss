}

QPushButton[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][objectName="primary"]:disabled,
[uiStyle="meeting-booking-dialog-this"] QPushButton[objectName="primary"]:disabled {
    background: @accent-soft@;
    color: @text-muted@;
}

QPushButton[uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][uiStyle="meeting-booking-dialog-this"][objectName="secondary"],
[uiStyle="meeting-booking-dialog-this"] QPushButton[objectName="secondary"] {
    background: @surface-alt@;
    color: @text-secondary@;
    border: none;
}

[uiStyle="meeting-booking-dialog-statuslabel"][uiStyle="meeting-booking-dialog-statuslabel"][uiStyle="meeting-booking-dialog-statuslabel"],
[uiStyle="meeting-booking-dialog-statuslabel"] * {
    color: @warning@;
}

[uiStyle="meeting-booking-dialog-statuslabel-2"][uiStyle="meeting-booking-dialog-statuslabel-2"][uiStyle="meeting-booking-dialog-statuslabel-2"],
[uiStyle="meeting-booking-dialog-statuslabel-2"] * {
    color: @accent@;
}

[uiStyle="meeting-booking-dialog-statuslabel-3"][uiStyle="meeting-booking-dialog-statuslabel-3"][uiStyle="meeting-booking-dialog-statuslabel-3"],
[uiStyle="meeting-booking-dialog-statuslabel-3"] * {
    color: @warning@;
}

QPlainTextEdit[uiStyle="meeting-chat-sidebar-widget-this"][uiStyle="meeting-chat-sidebar-widget-this"][uiStyle="meeting-chat-sidebar-widget-this"],
[uiStyle="meeting-chat-sidebar-widget-this"] QPlainTextEdit {
    background-color: @surface@;
    border: 1px solid @border@;
    border-radius: 6px;
    color: @text@;
    padding: 6px 8px;
    font-size: 13px;
    font-family: "Microsoft YaHei", sans-serif;
}

