    background: @hover@;
    color: @text@;
}
[uiStyle="floating-member-list-window"] QWidget#floatingMemberListTitleBar QToolButton:checked {
    background: @accent-soft@;
    color: @accent@;
}
[uiStyle="floating-member-list-window"] QWidget#floatingMemberListTitleBar QToolButton#floatingMemberListDock:hover {
    background: @danger@;
    color: @on-accent@;
}

