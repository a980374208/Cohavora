/* Application widget variants. Selected with AppTheme::setStyleVariant. */

QWidget[uiStyle="whiteboard-panel"],
[uiStyle="whiteboard-panel"] QScrollArea,
[uiStyle="whiteboard-panel"] QScrollArea > QWidget > QWidget,
[uiStyle="whiteboard-panel"] QWidget#whiteboardTextBox {
    background: @window@;
    color: @text@;
    border: none;
}
[uiStyle="whiteboard-panel"] QLabel {
    color: @text-secondary@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QLabel#whiteboardTitle {
    color: @text@;
    font-size: 16px;
    font-weight: bold;
}
[uiStyle="whiteboard-panel"] QLabel#whiteboardLocalNotice {
    color: @accent@;
    background: @accent-soft@;
    border-radius: 6px;
    padding: 4px 8px;
}
[uiStyle="whiteboard-panel"] QPushButton {
    color: @text@;
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 6px 10px;
    min-height: 20px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QPushButton:hover {
    color: @accent@;
    border-color: @accent-soft@;
    background: @accent-soft@;
}
[uiStyle="whiteboard-panel"] QPushButton:checked,
[uiStyle="whiteboard-panel"] QPushButton:pressed {
    color: @accent@;
    border-color: @accent@;
    background: @accent-soft@;
}
[uiStyle="whiteboard-panel"] QPushButton:disabled {
    color: @text-muted@;
    background: @surface-alt@;
    border-color: @border@;
}
[uiStyle="whiteboard-panel"] QComboBox,
[uiStyle="whiteboard-panel"] QSpinBox,
[uiStyle="whiteboard-panel"] QPlainTextEdit {
    color: @text@;
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 6px 36px 6px 8px;
    min-height: 20px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="whiteboard-panel"] QPlainTextEdit { padding: 6px; }

QDialog[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QDialog {
    background: transparent;
}

[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="loginCard"],
[uiStyle="login-dialog-this"] [objectName="loginCard"] {
    background-color: @surface@;
    border-radius: 16px;
    border: 1px solid @border@;
}

QLabel[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QLabel {
    color: @text@;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
}

QLineEdit[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QLineEdit {
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 10px 14px;
    font-size: 13px;
    background: @surface-alt@;
}

QLineEdit[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]:focus,
[uiStyle="login-dialog-this"] QLineEdit:focus {
    border: 1px solid @accent@;
    background: @surface@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"] {
    background-color: @accent@;
    color: @on-accent@;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: bold;
    border: none;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:hover {
    background-color: @accent-hover@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:pressed,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:pressed {
    background-color: @accent-pressed@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="primaryBtn"]:disabled,
[uiStyle="login-dialog-this"] QPushButton[objectName="primaryBtn"]:disabled {
    background-color: @accent-soft@;
    color: @text-muted@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"] {
    background-color: @surface-alt@;
    color: @text@;
    border-radius: 8px;
    padding: 10px 24px;
    font-size: 14px;
    border: 1px solid @border@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="guestBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="guestBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:hover {
    background-color: @hover@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:focus {
    border-color: @accent@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:pressed {
    background-color: @pressed@;
}

[uiStyle="login-dialog-this"] QPushButton[objectName="resumeSavedSession"]:disabled {
    background-color: @surface-alt@;
    color: @text-muted@;
    border-color: @border@;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="linkBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="linkBtn"] {
    background: transparent;
    color: @accent@;
    font-size: 12px;
    border: none;
    padding: 0;
    text-align: left;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="linkBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="linkBtn"]:hover {
    color: @accent-hover@;
    text-decoration: underline;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="closeBtn"],
[uiStyle="login-dialog-this"] QPushButton[objectName="closeBtn"] {
    background: transparent;
    border: none;
    font-size: 16px;
    color: @text-muted@;
    border-radius: 4px;
}

QPushButton[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][objectName="closeBtn"]:hover,
[uiStyle="login-dialog-this"] QPushButton[objectName="closeBtn"]:hover {
    background: @surface-alt@;
    color: @danger@;
}

QCheckBox[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"],
[uiStyle="login-dialog-this"] QCheckBox {
    font-size: 12px;
    color: @text-secondary@;
}

QTabWidget[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]::pane,
[uiStyle="login-dialog-this"] QTabWidget::pane {
    border: none;
    background: transparent;
}

QTabBar[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]::tab,
[uiStyle="login-dialog-this"] QTabBar::tab {
    background: transparent;
    color: @text-muted@;
    font-size: 13px;
    font-weight: 500;
    padding: 8px 14px;
    min-width: 80px;
    border-bottom: 2px solid transparent;
}

QTabBar[uiStyle="login-dialog-this"][uiStyle="login-dialog-this"][uiStyle="login-dialog-this"]::tab:selected,
[uiStyle="login-dialog-this"] QTabBar::tab:selected {
    color: @accent@;
    border-bottom: 2px solid @accent@;
    font-weight: bold;
}

[uiStyle="login-dialog-subtitle"][uiStyle="login-dialog-subtitle"][uiStyle="login-dialog-subtitle"],
[uiStyle="login-dialog-subtitle"] * {
    color: @text-muted@;
    font-size: 12px;
}

[uiStyle="login-dialog-togglepwdbtn"][uiStyle="login-dialog-togglepwdbtn"][uiStyle="login-dialog-togglepwdbtn"],
[uiStyle="login-dialog-togglepwdbtn"] * {
    border: 1px solid @border@;
    border-radius: 8px;
    background: @surface-alt@;
}

[uiStyle="login-dialog-toggleregpwdbtn"][uiStyle="login-dialog-toggleregpwdbtn"][uiStyle="login-dialog-toggleregpwdbtn"],
[uiStyle="login-dialog-toggleregpwdbtn"] * {
