/* The source picker uses native QComboBox/QDialogButtonBox controls. Set both
   foreground and background so Windows cannot keep a light native surface. */
[uiStyle="screen-share-picker"] QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    color: @text@;
}

[uiStyle="screen-share-picker"] QComboBox {
    min-height: 34px;
    padding: 0 36px 0 10px;
    border: 1px solid @border@;
    border-radius: 5px;
    background: @surface@;
    color: @text@;
}

[uiStyle="screen-share-picker"] QComboBox:hover,
[uiStyle="screen-share-picker"] QComboBox:focus {
    border-color: @accent@;
}

[uiStyle="screen-share-picker"] QComboBox:disabled {
    background: @surface-alt@;
    color: @text-muted@;
    border-color: @border@;
}

[uiStyle="screen-share-picker"] QPushButton {
    min-width: 76px;
    min-height: 34px;
    padding: 0 16px;
    border: 1px solid @border@;
    border-radius: 5px;
    background: @surface@;
    color: @text@;
}

[uiStyle="screen-share-picker"] QPushButton:hover,
[uiStyle="screen-share-picker"] QPushButton:focus {
    border-color: @accent@;
    background: @hover@;
}

[uiStyle="screen-share-picker"] QPushButton:pressed {
    background: @pressed@;
}

[uiStyle="screen-share-picker"] QPushButton#screenShareAccept,
[uiStyle="screen-share-picker"] QPushButton#screenShareQualityApply {
    background: @accent@;
    color: @on-accent@;
    border-color: @accent@;
}

[uiStyle="screen-share-picker"] QPushButton#screenShareAccept:hover,
[uiStyle="screen-share-picker"] QPushButton#screenShareAccept:focus,
[uiStyle="screen-share-picker"] QPushButton#screenShareQualityApply:hover,
[uiStyle="screen-share-picker"] QPushButton#screenShareQualityApply:focus {
    background: @accent-hover@;
    border-color: @accent-hover@;
}

[uiStyle="screen-share-picker"] QPushButton#screenShareAccept:pressed,
[uiStyle="screen-share-picker"] QPushButton#screenShareQualityApply:pressed {
    background: @accent-pressed@;
    border-color: @accent-pressed@;
}

[uiStyle="screen-share-picker"] QPushButton:disabled,
[uiStyle="screen-share-picker"] QPushButton#screenShareAccept:disabled,
[uiStyle="screen-share-picker"] QPushButton#screenShareQualityApply:disabled {
    background: @surface-alt@;
    color: @text-muted@;
    border-color: @border@;
