    border-radius: 10px;
}
[uiStyle="main-home-window"] QLabel#mainPresetLabel {
    color: @text-muted@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
[uiStyle="main-home-window"] QPushButton#mainPresetMic,
[uiStyle="main-home-window"] QPushButton#mainPresetCamera,
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee {
    background: @surface-alt@;
    color: @text-muted@;
    border: 1px solid @border@;
    border-radius: 7px;
    padding: 0 10px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
[uiStyle="main-home-window"] QPushButton#mainPresetMic:hover,
[uiStyle="main-home-window"] QPushButton#mainPresetCamera:hover,
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee:hover {
    background: @hover@;
    color: @text@;
}
[uiStyle="main-home-window"] QPushButton#mainPresetMic:checked,
[uiStyle="main-home-window"] QPushButton#mainPresetCamera:checked,
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee[presetTone="active"] {
    background: @accent-soft@;
    color: @accent@;
    border-color: transparent;
}
[uiStyle="main-home-window"] QPushButton#mainPresetMic:checked:hover,
[uiStyle="main-home-window"] QPushButton#mainPresetCamera:checked:hover,
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee[presetTone="active"]:hover {
    border-color: @accent@;
}
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee[presetTone="neutral"] {
    color: @text-secondary@;
}
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee[presetTone="warning"] {
    background: @warning-soft@;
    color: @warning@;
    border-color: transparent;
}
[uiStyle="main-home-window"] QPushButton#mainPresetE2ee[presetTone="warning"]:hover {
    border-color: @warning@;
}
[uiStyle="main-home-window"] QPushButton#mainMoreSettings {
    background: transparent;
    color: @text-secondary@;
    border: none;
    border-radius: 6px;
    padding: 0 8px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
[uiStyle="main-home-window"] QPushButton#mainMoreSettings:hover {
    background: @hover@;
    color: @text@;
}

/* Main window schedule card */
[uiStyle="schedule-card-widget"] QFrame#scheduleCardFrame {
    background: @surface@;
    border: 1px solid @border@;
    border-radius: 12px;
}
[uiStyle="schedule-card-widget"] QWidget#scheduleCardHeader {
    background: transparent;
    border-bottom: 1px solid @border@;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleCardTitle {
    color: @text@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleCountBadge {
    color: @text-secondary@;
    background: @surface-alt@;
    border-radius: 9px;
    min-width: 20px;
    padding: 1px 7px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 11px;
    font-weight: 600;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleRefreshBtn {
    background: transparent;
    color: @text-secondary@;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleRefreshBtn:hover {
    background: @hover@;
    color: @text@;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleRefreshBtn:disabled {
    color: @text-muted@;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleAllMeetingsBtn {
    background: transparent;
    color: @accent@;
    border: none;
    border-radius: 6px;
    padding: 4px 8px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 600;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleAllMeetingsBtn:hover {
    background: @accent-soft@;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleBannerLabel {
    background: @surface-alt@;
    color: @text-secondary@;
    border-bottom: 1px solid @border@;
    padding: 6px 16px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="schedule-card-widget"] QWidget#scheduleCardBody,
[uiStyle="schedule-card-widget"] QWidget#scheduleEmptyPanel,
[uiStyle="schedule-card-widget"] QWidget#scheduleStatePanel {
    background: transparent;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleEmptyIcon {
    background: @surface-alt@;
    border-radius: 12px;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleEmptyTitle {
    color: @text@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 13px;
    font-weight: 600;
}
[uiStyle="schedule-card-widget"] QLabel#scheduleEmptySubtitle,
[uiStyle="schedule-card-widget"] QLabel#scheduleStateMessage {
    color: @text-muted@;
    background: transparent;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleEmptyActionBtn,
[uiStyle="schedule-card-widget"] QPushButton#scheduleStateRetryBtn {
    background: @surface-alt@;
    color: @text@;
    border: 1px solid @border@;
    border-radius: 8px;
    padding: 6px 14px;
    font-family: "Microsoft YaHei", "Segoe UI", sans-serif;
    font-size: 12px;
    font-weight: 500;
}
[uiStyle="schedule-card-widget"] QPushButton#scheduleEmptyActionBtn:hover,
[uiStyle="schedule-card-widget"] QPushButton#scheduleStateRetryBtn:hover {
    background: @hover@;
    border-color: @accent@;
}
