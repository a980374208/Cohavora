<RCC>
  <qresource prefix="/meeting-ui/icons">
    <file alias="chevron-down-light.svg">icons/chevron-down-light.svg</file>
    <file alias="chevron-up-light.svg">icons/chevron-up-light.svg</file>
    <file alias="chevron-down-dark.svg">icons/chevron-down-dark.svg</file>
    <file alias="chevron-up-dark.svg">icons/chevron-up-dark.svg</file>
    <file alias="chevron-down-disabled.svg">icons/chevron-down-disabled.svg</file>
    <file alias="chevron-up-disabled.svg">icons/chevron-up-disabled.svg</file>
  </qresource>
  <qresource prefix="/meeting-ui/styles">
    <file alias="application.qss">styles/application.qss</file>
    <file alias="widgets.qss">styles/widgets.qss</file>
  </qresource>
</RCC>
