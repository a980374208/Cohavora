+		}
+		info := &livekit.TrackInfo{Sid: "screen", Type: livekit.TrackType_VIDEO, Source: livekit.TrackSource_SCREEN_SHARE,
+			Width: width, Height: height,
+			Layers: []*livekit.VideoLayer{layer(livekit.VideoQuality_LOW, 4), layer(livekit.VideoQuality_MEDIUM, 2)},
+			Codecs: []*livekit.SimulcastCodecInfo{
+				{MimeType: "video/VP8", Layers: []*livekit.VideoLayer{layer(livekit.VideoQuality_LOW, 4), layer(livekit.VideoQuality_MEDIUM, 2)}},
+				{MimeType: "video/H264", Layers: []*livekit.VideoLayer{layer(livekit.VideoQuality_LOW, 4), layer(livekit.VideoQuality_MEDIUM, 2)}},
+			},
+		}
+		telemetry := &typesfakes.FakeParticipantTelemetryListener{}
+		track := NewMediaTrackReceiver(MediaTrackReceiverParams{PreserveSignalledVideoDimensions: true, Logger: logger.GetLogger(), MediaTrack: &typesfakes.FakeMediaTrack{}, ParticipantID: func() livekit.ParticipantID { return "publisher" },
+			TelemetryListener: func() types.ParticipantTelemetryListener { return telemetry }}, info)
+		// One-shot clients derive top-level geometry from media as before.
+		oneShot := NewMediaTrackReceiver(MediaTrackReceiverParams{Logger: logger.GetLogger(),
