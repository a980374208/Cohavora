+		require.Equal(t, width/2, track.TrackInfo().Codecs[1].Layers[1].Width)
+		track.UpdateVideoSize(mime.MimeTypeVP8, []codec.VideoSize{{Width: width / 4, Height: height / 4}, {Width: width / 2, Height: height / 2}})
