+		require.Equal(t, height*2, oneShot.TrackInfo().Height)
+		before := track.TrackInfo()
+		require.Equal(t, livekit.VideoQuality_MEDIUM, track.GetQualityForDimension(mime.MimeTypeVP8, width/2, height/2))
+		track.UpdateVideoSize(mime.MimeTypeVP8, []codec.VideoSize{{Width: width / 2, Height: height / 2}, {Width: width, Height: height}})
