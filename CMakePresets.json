{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "app-base",
      "hidden": true,
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "COHAVORA_BUILD_MEETING_APP": "ON",
        "COHAVORA_BUILD_SAMPLES": "OFF"
      }
    },
    {
      "name": "windows-base",
      "hidden": true,
      "inherits": "app-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-vs2026-base",
      "hidden": true,
      "inherits": "windows-base",
      "generator": "Visual Studio 18 2026",
      "architecture": "x64"
    },
    {
      "name": "windows-vs2026-dev",
      "displayName": "Windows VS 2026 - Development",
      "inherits": "windows-vs2026-base",
      "cacheVariables": {
        "COHAVORA_BUILD_SAMPLES": "ON"
      }
    },
    {
      "name": "windows-vs2026-release",
      "displayName": "Windows VS 2026 - Release",
      "inherits": "windows-vs2026-base",
      "cacheVariables": {
        "COHAVORA_REQUIRE_UI_TRANSLATIONS": "ON"
      }
    },
    {
      "name": "windows-clion-ninja-base",
      "hidden": true,
      "inherits": "windows-base",
      "generator": "Ninja",
      "architecture": {
        "value": "x64",
        "strategy": "external"
      },
      "cacheVariables": {
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "windows-clion-debug",
      "displayName": "Windows CLion - Debug",
      "inherits": "windows-clion-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "windows-clion-relwithdebinfo",
      "displayName": "Windows CLion - RelWithDebInfo",
      "inherits": "windows-clion-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "windows-clion-release",
      "displayName": "Windows CLion - Release",
      "inherits": "windows-clion-ninja-base",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release",
        "COHAVORA_REQUIRE_UI_TRANSLATIONS": "ON"
      }
    },
    {
      "name": "ubuntu-ninja-relwithdebinfo",
      "displayName": "Ubuntu x64 - Basic Meeting",
      "inherits": "app-base",
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ubuntu",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "CMAKE_EXPORT_COMPILE_COMMANDS": "ON"
      }
    },
    {
      "name": "ubuntu-product",
      "displayName": "Ubuntu x64 - Full Product UI",
      "inherits": "ubuntu-ninja-relwithdebinfo",
      "binaryDir": "${sourceDir}/out/build/ubuntu-product",
      "cacheVariables": {
        "COHAVORA_LINUX_PRODUCT_UI": "ON"
      }
    },
    {
      "name": "ubuntu-clion-release",
      "displayName": "Ubuntu CLion - Release",
      "inherits": "ubuntu-product",
      "binaryDir": "${sourceDir}/out/build/ubuntu-clion-release",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "windows-app-build-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Windows"
      },
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "ubuntu-app-build-base",
      "hidden": true,
      "condition": {
        "type": "equals",
        "lhs": "${hostSystemName}",
        "rhs": "Linux"
      },
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "dev-debug",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-vs2026-dev",
      "configuration": "Debug"
    },
    {
      "name": "all-debug",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-vs2026-dev",
      "configuration": "Debug",
      "targets": [
        "ALL_BUILD"
      ]
    },
    {
      "name": "release",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-vs2026-release",
      "configuration": "Release"
    },
    {
      "name": "windows-clion-debug",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-clion-debug"
    },
    {
      "name": "windows-clion-relwithdebinfo",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-clion-relwithdebinfo"
    },
    {
      "name": "windows-clion-release",
      "inherits": "windows-app-build-base",
      "configurePreset": "windows-clion-release"
    },
    {
      "name": "ubuntu-meeting",
      "inherits": "ubuntu-app-build-base",
      "configurePreset": "ubuntu-ninja-relwithdebinfo"
    },
    {
      "name": "ubuntu-receiver",
      "description": "Compatibility alias for ubuntu-meeting.",
      "inherits": "ubuntu-meeting"
    },
    {
      "name": "ubuntu-product",
      "inherits": "ubuntu-app-build-base",
      "configurePreset": "ubuntu-product"
    },
    {
      "name": "ubuntu-clion-release",
      "inherits": "ubuntu-app-build-base",
      "configurePreset": "ubuntu-clion-release"
    }
  ]
}
