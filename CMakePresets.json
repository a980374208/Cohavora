{
  "version": 3,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "windows-vs2026-base",
      "hidden": true,
      "generator": "Visual Studio 18 2026",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/out/build/${presetName}",
      "cacheVariables": {
        "VCPKG_TARGET_TRIPLET": "x64-windows-static"
      }
    },
    {
      "name": "windows-vs2026-dev",
      "displayName": "Windows VS 2026 - Development",
      "inherits": "windows-vs2026-base",
      "cacheVariables": {
        "COHAVORA_BUILD_MEETING_APP": "ON",
        "COHAVORA_BUILD_SAMPLES": "ON"
      }
    },
    {
      "name": "windows-vs2026-release",
      "displayName": "Windows VS 2026 - Release",
      "inherits": "windows-vs2026-base",
      "cacheVariables": {
        "COHAVORA_BUILD_MEETING_APP": "ON",
        "COHAVORA_BUILD_SAMPLES": "OFF",
        "COHAVORA_REQUIRE_UI_TRANSLATIONS": "ON"
      }
    },
    {
      "name": "ubuntu-ninja-relwithdebinfo",
      "displayName": "Ubuntu x64 - Basic Meeting",
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/out/build/ubuntu",
      "cacheVariables": {
        "CMAKE_TOOLCHAIN_FILE": "$env{VCPKG_ROOT}/scripts/buildsystems/vcpkg.cmake",
        "CMAKE_BUILD_TYPE": "RelWithDebInfo",
        "COHAVORA_BUILD_MEETING_APP": "ON",
        "COHAVORA_BUILD_SAMPLES": "OFF"
      }
    },
    {
      "name": "ubuntu-product",
      "displayName": "Ubuntu x64 - Full Product UI",
      "inherits": "ubuntu-ninja-relwithdebinfo",
      "binaryDir": "${sourceDir}/out/build/ubuntu-product",
      "cacheVariables": {
        "COHAVORA_LINUX_PRODUCT_UI": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "dev-debug",
      "configurePreset": "windows-vs2026-dev",
      "configuration": "Debug",
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "all-debug",
      "configurePreset": "windows-vs2026-dev",
      "configuration": "Debug",
      "targets": [
        "ALL_BUILD"
      ]
    },
    {
      "name": "release",
      "configurePreset": "windows-vs2026-release",
      "configuration": "Release",
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "ubuntu-meeting",
      "configurePreset": "ubuntu-ninja-relwithdebinfo",
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "ubuntu-receiver",
      "configurePreset": "ubuntu-ninja-relwithdebinfo",
      "targets": [
        "cohavora_app"
      ]
    },
    {
      "name": "ubuntu-product",
      "configurePreset": "ubuntu-product",
      "targets": [
        "cohavora_app"
      ]
    }
  ]
}
